create_nutrient_table <- function(df, nutrient) {
  bounds <- nutrient_bounds[[nutrient]]
  
  table_data <- df %>%
    select(organization, farmer_name, all_of(nutrient)) %>%
    arrange(organization, !!sym(nutrient)) %>%
    group_by(organization) %>%
    mutate(rank = row_number()) %>%
    ungroup() %>%
    mutate(
      value_str = ifelse(is.na(!!sym(nutrient)), "-", sprintf("%.3f", !!sym(nutrient))),
      farmer_val = paste0(farmer_name, " — ", value_str)
    )
  
  orgs <- sort(unique(table_data$organization))
  half <- ceiling(length(orgs) / 2)
  left_orgs <- orgs[1:half]
  right_orgs <- orgs[(half + 1):length(orgs)]
  
  make_wide <- function(org_block) {
    table_data %>%
      filter(organization %in% org_block) %>%
      select(organization, rank, farmer_val) %>%
      pivot_wider(names_from = organization, values_from = farmer_val)
  }
  
  left_wide  <- make_wide(left_orgs)
  right_wide <- make_wide(right_orgs)
  
  final_table <- left_join(left_wide, right_wide, by = "rank") %>% select(-rank)
  final_table <- final_table %>% mutate(across(everything(), ~replace_na(., "-")))
  
  gt(final_table) %>%
    tab_header(
      title = paste0(str_to_title(str_replace_all(nutrient, "_", " ")), " by Organization"),
      subtitle = "Sorted within organization"
    ) %>%
    cols_align(align = "center", everything()) %>%
    tab_options(
      table.font.size = 12,
      data_row.padding = px(2),
      table.border.top.color = "black",
      table.border.bottom.color = "black"
    ) %>%
    data_color(
      columns = everything(),
      fn = function(x) {
        vals <- suppressWarnings(as.numeric(str_extract(x, "-?\\d+\\.?\\d*")))
        ifelse(is.na(vals), "white",
               ifelse(!is.na(bounds$lower) & vals < bounds$lower, "gray",
                      ifelse(!is.na(bounds$upper) & vals > bounds$upper, "red", "green")
               )
        )
      }
    ) %>%
    tab_source_note(
      source_note = md("**Legend:** Gray = Below permissible range | Green = Within range | Red = Above permissible range")
    )
}

