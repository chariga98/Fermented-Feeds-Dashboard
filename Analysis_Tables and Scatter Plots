org_palette <- c("#1F4BD8","#000001","#009E73","#FFED29","#ED2100")

# Distribution ----------------------------------------------------
plot_distribution <- function(df, nutrient) {
  bounds <- nutrient_bounds[[nutrient]]
  p <- ggplot(df, aes(x = .data[[nutrient]])) +
    geom_histogram(bins = 25, fill = "#1F4BD8", alpha = 0.85, color = "white") +
    theme_minimal(base_size = 14) +
    labs(title = glue("Distribution of {nutrient}"), x = nutrient, y = "Frequency")
  if (!is.na(bounds$lower)) p <- p + geom_vline(xintercept = bounds$lower, linetype="dotted", color="gray", linewidth=1)
  if (!is.na(bounds$upper)) p <- p + geom_vline(xintercept = bounds$upper, linetype="dotted", color="red", linewidth=1)
  p
}

# Farmer Scatter --------------------------------------------------
plot_farmer_scatter <- function(df, nutrient) {
  bounds <- nutrient_bounds[[nutrient]]
  p <- ggplot(df, aes(x=factor(lab_id), y=.data[[nutrient]], color=organization)) +
    geom_point(size=2.8, alpha=0.85) +
    scale_color_manual(values=rep(org_palette, length.out=nlevels(df$organization))) +
    theme_minimal(base_size=13) +
    labs(title=glue("{nutrient}: Farmer-level Variation"), x="Farmer ID", y=nutrient, color="Organization") +
    theme(axis.text.x=element_text(angle=90, vjust=0.5, hjust=1))
  if (!is.na(bounds$lower)) p <- p + geom_hline(yintercept=bounds$lower, linetype="dotted", color="gray", linewidth=1)
  if (!is.na(bounds$upper)) p <- p + geom_hline(yintercept=bounds$upper, linetype="dotted", color="red", linewidth=1)
  p
}

# Material Scatter ------------------------------------------------
plot_material_scatter <- function(df, nutrient, title) {
  bounds <- nutrient_bounds[[nutrient]]
  p <- df %>%
    select(lab_id, organization, all_of(nutrient), where(is.integer)) %>%
    pivot_longer(-c(lab_id, organization, all_of(nutrient)), names_to="material", values_to="present") %>%
    filter(present==1) %>%
    ggplot(aes(material, .data[[nutrient]], color=organization)) +
    geom_jitter(width=0.25, size=2.6, alpha=0.8) +
    scale_color_manual(values=rep(org_palette, length.out=nlevels(df$organization))) +
    theme_minimal(base_size=13) +
    labs(title=glue("{title}: {nutrient}"), x="Feed Material", y=nutrient, color="Organization") +
    theme(axis.text.x=element_text(angle=45, hjust=1))
  if (!is.na(bounds$lower)) p <- p + geom_hline(yintercept=bounds$lower, linetype="dotted", color="gray", linewidth=1)
  if (!is.na(bounds$upper)) p <- p + geom_hline(yintercept=bounds$upper, linetype="dotted", color="red", linewidth=1)
  p
}

