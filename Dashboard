# 2. DATA IMPORT & CLEANING
# -----------------------------
Farmer_raw <- read_excel("Farmer_data.xlsx", .name_repair = "unique") %>% clean_names()
Feeds_raw  <- read_excel("Feeds_data.xlsx") %>% clean_names()

get_mode <- function(v) {
  uniqv <- unique(na.omit(v))
  if(length(uniqv)==0) return(NA)
  uniqv[which.max(tabulate(match(v, uniqv)))]
}

clean_numeric <- function(x) {
  x <- as.character(x); x <- gsub("[<>]", "", x)
  x <- gsub("ND|NT|N/A|NA|na", "", x, ignore.case=TRUE)
  as.numeric(x)
}

Farmer_raw <- Farmer_raw %>% 
  mutate(
    lab_id = as.character(lab_id),
    feed_type = tolower(trimws(feed_type)), 
    sample_type = trimws(sample_type),
    farmer_name = trimws(farmer_name),
    organization = trimws(organization)
  )

Feeds_raw <- Feeds_raw %>% mutate(lab_id = as.character(lab_id))

my_metrics <- c("percent_moisture_wet", "percent_dry_matter_wet", "total_ash_dry", "fibre_dry",
                "crude_fat_dry", "crude_prot_dry", "non_n_free_extract_dry", "total_carb_dry",
                "digestible_energy_dry", "calcium_dry", "phosphorus_dry", "tannins_dry", "fumonisins_dry")

plot_metrics <- c("percent_moisture_wet", "percent_dry_matter_wet", "total_ash_dry", "fibre_dry",
                  "crude_fat_dry", "crude_prot_dry", "non_n_free_extract_dry", "total_carb_dry",
                  "calcium_dry", "phosphorus_dry")

meta_cols <- c("previous_batches", "batch_quantity_kg", "age_of_batch_days", "total_diversity" ,"sample_p_h")

Farmer_raw <- Farmer_raw %>% 
  mutate(across(any_of(my_metrics), clean_numeric)) %>%
  mutate(across(any_of(meta_cols), clean_numeric))

# -----------------------------
# 3. ANALYSIS GROUPS
# -----------------------------
Farmer_Unique <- Farmer_raw %>%
  mutate(
    analysis_group = case_when(
      feed_type == "commercial" ~ "Commercial",
      grepl("Abaniibi A", sample_type, ignore.case=T) ~ "Abaniibi A",
      grepl("Abaniibi B", sample_type, ignore.case=T) ~ "Abaniibi B",
      grepl("Witharaga", sample_type, ignore.case=T) ~ "Witharaga",
      grepl("Individual", sample_type, ignore.case=T) ~ "Individual Sample",
      TRUE ~ "Other"
    )
  ) %>%
  distinct(lab_id, .keep_all = TRUE) 

Joined_Data <- Farmer_Unique %>% left_join(Feeds_raw, by = "lab_id")

# Calculation for Sliders
safe_max <- function(x, default) {
  val <- max(x, na.rm = TRUE); if(!is.finite(val)) return(default); return(val)
}
max_batches <- safe_max(Farmer_Unique$previous_batches, 10)
max_qty     <- safe_max(Farmer_Unique$batch_quantity_kg, 100)
max_age     <- safe_max(Farmer_Unique$age_of_batch_days, 30)
max_ph      <- safe_max(Farmer_Unique$sample_p_h, 14)
max_div      <- safe_max(Farmer_Unique$total_diversity, 50)
