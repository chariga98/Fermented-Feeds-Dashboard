# -----------------------------
# 5. SERVER LOGIC (UPDATED)
# -----------------------------
server <- function(input, output, session) {
  
  # --- DOWNLOAD LOGIC START ---
  # 1. Show the pop-up when button is clicked
  observeEvent(input$btn_download_modal, {
    showModal(modalDialog(
      title = "Restricted Data Access",
      passwordInput("download_pass", "Enter Admin Password:", placeholder = "Contact admin for access"),
      footer = tagList(
        modalButton("Cancel"),
        downloadButton("download_data_csv", "Verify & Download")
      ),
      easyClose = TRUE
    ))
  })
  
  # 2. Handle the actual download
  output$download_data_csv <- downloadHandler(
    filename = function() {
      paste("Fermented_Feeds_Data_", Sys.Date(), ".csv", sep = "")
    },
    content = function(file) {
      # Use whatever password you prefer here
      if (input$download_pass == "admin123") {
        removeModal() # Close the pop-up
        write.csv(filtered_data(), file, row.names = FALSE)
      } else {
        showNotification("Incorrect Password. Access Denied.", type = "error")
      }
    }
  )
  # --- DOWNLOAD LOGIC END ---
  
  filtered_data <- reactive({
    df_joined <- Joined_Data
    if(!("All" %in% input$org)) df_joined <- df_joined %>% filter(organization %in% input$org)
    if(!("All" %in% input$farmer)) df_joined <- df_joined %>% filter(farmer_name %in% input$farmer)
    if(!("All" %in% input$ingredient)) df_joined <- df_joined %>% filter(feed_ingredient %in% input$ingredient)
    valid_ids <- unique(df_joined$lab_id)
    
    Farmer_Unique %>% 
      filter(lab_id %in% valid_ids) %>%
      filter(
        (is.na(previous_batches) | (previous_batches >= input$batch_count[1] & previous_batches <= input$batch_count[2])),
        (is.na(batch_quantity_kg) | (batch_quantity_kg >= input$batch_qty[1] & batch_quantity_kg <= input$batch_qty[2])),
        (is.na(total_diversity) | (total_diversity >= input$diversity_total[1] & total_diversity <= input$diversity_total[2])),
        (is.na(age_of_batch_days) | (age_of_batch_days >= input$batch_age[1] & age_of_batch_days <= input$batch_age[2])),
        (is.na(sample_p_h) | (sample_p_h >= input$ph_range[1] & sample_p_h <= input$ph_range[2]))
      )
  })
  
  output$kpi_total <- renderText({ nrow(filtered_data()) })
  output$kpi_comm  <- renderText({ sum(filtered_data()$feed_type == "commercial", na.rm=T) })
  output$kpi_ferm  <- renderText({ sum(filtered_data()$feed_type == "fermented", na.rm=T) })
  output$kpi_ph    <- renderText({ 
    ph_vals <- na.omit(filtered_data()$sample_p_h)
    if(length(ph_vals) == 0) return("N/A"); round(mean(ph_vals), 2) 
  })
  
  generate_stats <- function(df, group_col, metric) {
    res <- df %>%
      filter(!is.na(.data[[metric]])) %>%
      group_by(across(all_of(group_col))) %>%
      summarise(
        Count = n(),
        Mean = round(mean(.data[[metric]], na.rm=T), 2),
        Median = round(median(.data[[metric]], na.rm=T), 2),
        Mode = round(get_mode(.data[[metric]]), 2),
        SD = round(sd(.data[[metric]], na.rm=T), 2),
        Variance = round(var(.data[[metric]], na.rm=T), 2),
        `CV (%)` = round((sd(.data[[metric]], na.rm=T) / mean(.data[[metric]], na.rm=T)) * 100, 2),
        Range = if(n() > 0) paste(round(min(.data[[metric]]),2), "-", round(max(.data[[metric]]),2)) else "N/A",
        IQR = round(IQR(.data[[metric]], na.rm=T), 2),
        .groups = "drop"
      )
    if(nrow(res) == 0) return(data.frame(Message = "No data available"))
    return(res)
  }
  
  output$table_feed_type <- renderTable({ generate_stats(filtered_data(), "feed_type", input$metric) })
  output$table_sample_type <- renderTable({ 
    filtered_data() %>% filter(feed_type == "fermented") %>% generate_stats("sample_type", input$metric) 
  })
  
  output$table_all_metrics <- renderDT({
    df <- filtered_data()
    all_stats <- lapply(my_metrics, function(m) {
      vals <- na.omit(df[[m]])
      if(length(vals) == 0) return(NULL)
      data.frame(
        Metric = gsub("_", " ", m),
        Count = length(vals),
        Mean = round(mean(vals), 2), Median = round(median(vals), 2),
        Mode = round(get_mode(vals), 2), SD = round(sd(vals), 2),
        Variance = round(var(vals), 2), `CV (%)` = round((sd(vals)/mean(vals))*100, 2),
        Range = paste(round(min(vals),2), "-", round(max(vals),2)), IQR = round(IQR(vals), 2)
      )
    })
    final_df <- do.call(rbind, all_stats)
    validate(need(!is.null(final_df), "No data available."))
    datatable(final_df, options = list(pageLength = 5, scrollX = TRUE), rownames = FALSE)
  })
  
  output$plot_metrics_avg_bar <- renderPlotly({
    df <- filtered_data()
    avg_df <- df %>%
      summarise(across(all_of(plot_metrics), \(x) mean(x, na.rm = TRUE))) %>%
      pivot_longer(everything(), names_to = "Metric", values_to = "Average") %>%
      mutate(Metric = gsub("_", " ", Metric))
    p <- ggplot(avg_df, aes(x=reorder(Metric, Average), y=Average, fill=Average)) +
      geom_col() + coord_flip() + scale_fill_gradient(low="#D1F2EB", high="#16A085") +
      theme_minimal() + labs(x="", y="Average Value")
    ggplotly(p)
  })
  
  output$plot_density_split <- renderPlotly({
    m <- input$metric; df <- filtered_data() %>% filter(!is.na(.data[[m]]), analysis_group != "Other")
    validate(need(nrow(df)>2, "Insufficient data for distribution."))
    p <- ggplot(df, aes(x=.data[[m]], fill=analysis_group, color=analysis_group)) +
      geom_density(alpha=0.4, adjust=1.5) + scale_fill_brewer(palette = "Set2") + theme_minimal()
    ggplotly(p)
  })
  
  output$plot_density_combined <- renderPlotly({
    m <- input$metric; df <- filtered_data() %>% filter(!is.na(.data[[m]]))
    validate(need(nrow(df)>2, "Insufficient data."))
    p <- ggplot(df, aes(x=.data[[m]], fill=feed_type, color=feed_type)) +
      geom_density(alpha=0.5, adjust=1.5) +
      scale_fill_manual(values=c("commercial"="#2C3E50", "fermented"="#E67E22")) + theme_minimal()
    ggplotly(p)
  })
  
  output$plot_bar_bench <- renderPlotly({
    m <- input$metric; df <- filtered_data() %>% filter(!is.na(.data[[m]])) %>% arrange(desc(.data[[m]]))
    validate(need(nrow(df)>0, "No data."))
    comm_avg <- mean(Farmer_Unique[[m]][Farmer_Unique$feed_type == "commercial"], na.rm=T)
    p <- ggplot(df, aes(x=reorder(lab_id, -.data[[m]]), y=.data[[m]], fill=feed_type,
                        text=paste("Farmer:", farmer_name, "<br>Val:", .data[[m]]))) +
      geom_col() + geom_hline(yintercept = comm_avg, linetype="dashed", color="#E74C3C", size=1) +
      scale_fill_manual(values=c("commercial"="#2C3E50", "fermented"="#5DADE2")) + 
      theme_minimal() + labs(x="Lab ID", y=m) +
      theme(axis.text.x = element_text(angle = 45, hjust = 1))
    ggplotly(p, tooltip="text")
  })
  
  output$plot_ingredients <- renderPlotly({
    ing_counts <- Joined_Data %>% 
      filter(lab_id %in% filtered_data()$lab_id, !is.na(feed_ingredient)) %>% count(feed_ingredient)
    validate(need(nrow(ing_counts)>0, "No ingredient data."))
    p <- ggplot(ing_counts, aes(x=reorder(feed_ingredient, n), y=n)) + 
      geom_col(fill="#27AE60") + coord_flip() + theme_minimal() + labs(x="", y="Count")
    ggplotly(p)
  })
  ##------------------
  ## AI Assistant
  ##-----------------
  # Reactive value to store the AI's answer
  ai_res <- reactiveVal("Waiting for your question...")
  
  observeEvent(input$send_chat, {
    # 1. Create the "Context" (Feeding your dashboard data to the AI)
   df <- filtered_data()
    
    # We summarize the data so the AI doesn't get overwhelmed
    data_summary <- paste0(
      "Context: You are an agricultural lab expert. Here is the current dashboard data summary: ",
      "Total samples: ", nrow(df), ". ",
      "Current Metric: ", input$metric, ". ",
      "Avg Value: ", round(mean(df[[input$metric]], na.rm=T), 2), ". ",
      "Most used ingredient: ", names(sort(table(Joined_Data$feed_ingredient), decreasing=TRUE)[1]), ". ",
      "The user is asking: "
)
    
    # 2. Show a 'Thinking' message
   ai_res("AI is analyzing your local data... please wait.")
    
    # 3. Talk to Ollama (Local)
    tryCatch({
      answer <- rollama::query(paste(data_summary, input$user_chat), model = "llama3")
     ai_res(answer$message$content)
    }, error = function(e) {
    ai_res("Error: Ensure Ollama is running in the background (Type 'ollama run llama3' in terminal).")
    })
})
  
 output$ai_response_ui <- renderUI({
    wellPanel(
      style = "background-color: #f4f6f7; border-left: 5px solid #3498db;",
      tags$b("AI Assistant:"),
      p(ai_res())
   )
 })
}

shinyApp(ui, server)
